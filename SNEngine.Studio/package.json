{
  "name": "snengine-studio",
  "version": "0.0.0",
  "description": "SNEngine Studio - Visual Novel Editor",
  "author": "SNEngine Team",
  "private": true,
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite --no-open",
    "build": "vite build",
    "electron:dev": "electron .",
    "electron:build": "vite build && electron-builder",
    "electron:dev:all": "concurrently \"npm run dev\" \"npm run electron:dev\""
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "monaco-editor": "^0.55.1",
    "monaco-editor-vue3": "^1.0.5",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.32",
    "vue-draggable-next": "^2.3.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-static-copy": "^4.1.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "build": {
    "appId": "com.snengine.studio",
    "productName": "SNEngine Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "npmRebuild": false,
    "electronDownload": {
      "cache": "C:\\Users\\Siphome\\AppData\\Local\\electron-builder\\Cache"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
