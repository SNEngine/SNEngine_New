{
  "name": "snengine-studio",
  "version": "0.0.111",
  "description": "SNEngine Studio - Visual Novel Editor",
  "author": "SNEngine Team",
  "private": true,
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite --no-open",
    "build": "vite build",
    "electron:dev": "electron .",
    "electron:build": "vite build && electron-builder",
    "electron:build-win": "vite build && electron-builder --win",
    "electron:build-mac": "vite build && electron-builder --mac",
    "electron:build-linux": "vite build && electron-builder --linux",
    "electron:dev:all": "npm version --no-git-tag-version patch && concurrently -k -n \"VITE,ELECTRON\" -c \"cyan,green\" \"npm run dev\" \"wait-on -t 30000 -v tcp:127.0.0.1:5173 && npm run electron:dev\""
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "monaco-editor": "^0.53.0",
    "monaco-editor-vue3": "^1.0.5",
    "node-pty": "^1.1.0",
    "sortablejs": "^1.15.7",
    "systeminformation": "^5.31.6",
    "vue": "^3.5.32",
    "vue-draggable-next": "^2.3.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-static-copy": "^4.1.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "build": {
    "appId": "com.snengine.studio",
    "productName": "SNEngine Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json",
      "preload.cjs",
      "build/icons/png/512x512.png"
    ],
    "icon": "build/icons/icon",
    "win": {
      "target": "nsis",
      "icon": "build/icons/win/icon.ico"
    },
    "mac": {
      "icon": "build/icons/mac/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "build/icons/png/512x512.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "forceCodeSigning": false,
    "npmRebuild": false,
    "electronDownload": {
      "cache": "C:\\Users\\Siphome\\AppData\\Local\\electron-builder\\Cache"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
