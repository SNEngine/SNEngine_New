<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SNEngine.Studio.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="SNEngine.Studio.Views.MainWindow"
        Title="SNEngine Studio"
        x:DataType="vm:MainViewModel">

	<Design.DataContext>
		<vm:MainViewModel/>
	</Design.DataContext>

	<Grid RowDefinitions="Auto,*" Margin="12">

		<!-- Toolbar -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
			<Button Content="Новый проект"
                    Command="{Binding CreateNewProjectCommand}"
                    Padding="20,8"/>

			<Button Content="Открыть проект"
                    Command="{Binding OpenProjectCommand}"
                    Padding="20,8"/>

			<!-- Кнопка сборки -->
			<Button Content="Собрать игру (Windows)"
                    Command="{Binding BuildGameCommand}"
                    Padding="20,8"
                    IsEnabled="{Binding CurrentProject.IsLoaded}"/>
		</StackPanel>

		<!-- Основная область -->
		<Grid Grid.Row="1">
			<TextBlock Text="{Binding StatusText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"
                       Foreground="White"/>
		</Grid>
	</Grid>
</Window>